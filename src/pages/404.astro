---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="container section lost">
    <p class="code" aria-hidden="true">404</p>
    <h1>This page took a wrong turn.</h1>
    <p class="muted">Like my pilot career, it didn't quite go to plan. Let's get you somewhere useful.</p>
    <div class="actions">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn" href="/projects">See my projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .code {
    font-family: var(--mono);
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
    opacity: 0.3;
    margin-bottom: 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
</style>
