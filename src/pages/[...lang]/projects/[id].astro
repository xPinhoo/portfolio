---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import ProjectVisual from '../../../components/ProjectVisual.astro';
import SleepDiaryDemo from '../../../components/SleepDiaryDemo.vue';
import { getProjects } from '../../../lib/content';
import { href, langOf, langPaths, langs } from '../../../i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const [i, lang] of langs.entries()) {
    for (const project of await getProjects(lang)) {
      paths.push({ params: { ...langPaths()[i].params, id: project.id }, props: { project } });
    }
  }
  return paths;
}

const { project } = Astro.props;
const lang = langOf(Astro.url);
const { title, summary, tech, repo, demo, cover, visual, status, period, role, interactive } = project.data;
const { Content } = await render(project.source);
const copy = {
  en: {
    back: '← All projects',
    role: 'Role',
    builtWith: 'Built with',
    tryHere: '▶ Try it here',
    visit: 'Visit the live site ↗',
    source: 'Source code',
    screenshot: `Screenshot of ${title}`,
    demoEyebrow: 'Interactive demo',
    demoTitle: 'Try the sleep diary',
    demoIntro:
      "The app's core feature, rebuilt here in Vue with the same questions, rules and calculations, translated into English. Fill in last night and you'll get the same report the app gives.",
  },
  pt: {
    back: '← Todos os projetos',
    role: 'Função',
    builtWith: 'Tecnologias',
    tryHere: '▶ Experimente aqui',
    visit: 'Visitar o site ↗',
    source: 'Código-fonte',
    screenshot: `Captura de ecrã de ${title}`,
    demoEyebrow: 'Demo interativa',
    demoTitle: 'Experimente o diário do sono',
    demoIntro:
      'A funcionalidade principal da aplicação, recriada aqui em Vue com as mesmas perguntas, regras e cálculos. Preencha a última noite e receberá o mesmo relatório que a aplicação apresenta.',
  },
}[lang];
---

<BaseLayout title={title} description={summary}>
  <article class="container section narrow">
    <a href={href(lang, '/projects')} class="back">{copy.back}</a>
    <div class="meta">
      <StatusBadge status={status} />
      <span class="period">{period}</span>
    </div>
    <h1>{title}</h1>
    <p class="lead muted">{summary}</p>

    <dl class="facts">
      {
        role && (
          <div>
            <dt>{copy.role}</dt>
            <dd>{role}</dd>
          </div>
        )
      }
      <div>
        <dt>{copy.builtWith}</dt>
        <dd>
          <ul class="tags">
            {tech.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>

    {
      (repo || demo) && (
        <div class="actions">
          {interactive && (
            <a class="btn primary" href="#try-it">
              {copy.tryHere}
            </a>
          )}
          {demo && (
            <a class:list={['btn', { primary: !interactive }]} href={demo} target="_blank" rel="noopener">
              {copy.visit}
            </a>
          )}
          {repo && (
            <a class="btn" href={repo} target="_blank" rel="noopener">
              {copy.source}
            </a>
          )}
        </div>
      )
    }
    {cover && <Image class="cover reveal" src={cover} alt={copy.screenshot} width={1200} />}
    {
      !cover && visual && (
        <div class="cover banner reveal">
          <ProjectVisual visual={visual} />
        </div>
      )
    }
    {
      interactive === 'sleep-diary' && (
        <section class="try reveal" id="try-it">
          <p class="eyebrow">{copy.demoEyebrow}</p>
          <h2>{copy.demoTitle}</h2>
          <p class="muted">{copy.demoIntro}</p>
          <SleepDiaryDemo client:idle lang={lang} />
        </section>
      )
    }
    <div class="prose body reveal">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .period {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .lead {
    font-size: 1.15rem;
  }
  .facts {
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0 0;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cover {
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .banner {
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }
  .try {
    margin-top: 2.5rem;
    scroll-margin-top: 80px;
  }
  .try h2 {
    margin-bottom: 0.4rem;
  }
  .try > .muted {
    margin-bottom: 1.25rem;
  }
  .body {
    margin-top: 2rem;
  }
</style>
