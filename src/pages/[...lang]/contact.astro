---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links, profile } from '../../data/site';
import { langOf, langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const copy = {
  en: {
    title: 'Contact',
    description: `Get in touch with ${profile.name}`,
    heading: "Let's talk.",
    lead: 'Always happy to talk about interesting projects and roles. The fastest way to reach me is by email or LinkedIn.',
    based: 'Based in',
  },
  pt: {
    title: 'Contacto',
    description: `Entre em contacto com ${profile.name}`,
    heading: 'Vamos conversar.',
    lead: 'Estou sempre disponível para falar sobre projetos e oportunidades interessantes. A forma mais rápida de me contactar é por email ou LinkedIn.',
    based: 'Localização',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="container section narrow">
    <p class="eyebrow">{copy.title}</p>
    <h1>{copy.heading}</h1>
    <p class="muted lead">
      {copy.lead}
    </p>
    <div class="list">
      <a class="card row" href={`mailto:${profile.email}`}>
        <span class="muted">{t(lang).email}</span>
        <strong>{profile.email}</strong>
      </a>
      <a class="card row" href={links.linkedin} target="_blank" rel="noopener">
        <span class="muted">LinkedIn</span>
        <strong>francisco-pinho</strong>
      </a>
      {
        links.github && (
          <a class="card row" href={links.github} target="_blank" rel="noopener">
            <span class="muted">GitHub</span>
            <strong>{links.github.replace('https://github.com/', '')}</strong>
          </a>
        )
      }
      <div class="card row">
        <span class="muted">{copy.based}</span>
        <strong>{profile.location}</strong>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 640px;
  }
  .lead {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--text);
    text-decoration: none;
    padding: 1rem 1.25rem;
  }
  a.row:hover {
    border-color: var(--accent);
  }
  strong {
    overflow-wrap: anywhere;
  }
</style>
