---
import { Image } from 'astro:assets';
import profilePhoto from '../../assets/profile.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';
import { getExperience, getProjects } from '../../lib/content';
import { highlights, links, profile } from '../../data/site';
import { href, langOf, langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const experience = await getExperience(lang);
const projects = (await getProjects(lang)).slice(0, 3);
const firstName = profile.shortName.split(' ')[0];
const copy = {
  en: {
    hi: `Hi, I'm ${firstName}.`,
    viewExperience: 'View experience',
    cv: 'Download CV',
    emailMe: 'Email me',
    recent: 'Recent experience',
    fullCv: 'Full CV →',
    side: 'Side projects',
    allProjects: 'All projects →',
  },
  pt: {
    hi: `Olá, sou o ${firstName}.`,
    viewExperience: 'Ver experiência',
    cv: 'Descarregar CV',
    emailMe: 'Enviar email',
    recent: 'Experiência recente',
    fullCv: 'CV completo →',
    side: 'Projetos pessoais',
    allProjects: 'Todos os projetos →',
  },
}[lang];
---

<BaseLayout>
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow">{profile.role} · {profile.location}</p>
      <h1>{copy.hi}</h1>
      <p class="lead">{profile.headline[lang]}</p>
      <div class="actions">
        <a class="btn primary" href={href(lang, '/experience')}>{copy.viewExperience}</a>
        {profile.hasCv && <a class="btn" href="/cv.pdf" download>{copy.cv}</a>}
        <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={`mailto:${profile.email}`}>{copy.emailMe}</a>
      </div>
    </div>
    <Image
      class="avatar"
      src={profilePhoto}
      alt={t(lang).portraitOf(profile.name)}
      width={480}
      loading="eager"
    />
  </section>

  <section class="container">
    <ul class="highlights">
      {
        highlights.map((h) => (
          <li class="card">
            <strong>{h.value}</strong>
            <span class="muted">{h.label[lang]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section">
    <div class="head">
      <h2>{copy.recent}</h2>
      <a href={href(lang, '/experience')}>{copy.fullCv}</a>
    </div>
    <div>
      {experience.map((job) => <ExperienceItem job={job} compact />)}
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="container section">
        <div class="head">
          <h2>{copy.side}</h2>
          <a href={href(lang, '/projects')}>{copy.allProjects}</a>
        </div>
        <div class="grid">
          {projects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2.5rem;
  }
  .avatar {
    flex-shrink: 0;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 35%;
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 1px var(--border), 0 12px 32px -12px rgb(0 0 0 / 0.35);
  }
  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 640px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .highlights li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .highlights strong {
    font-size: 1.75rem;
    color: var(--accent);
    line-height: 1.1;
  }
  .highlights span {
    font-size: 0.9rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .avatar {
      order: -1;
      width: 120px;
      height: 120px;
    }
  }
  @media (max-width: 560px) {
    .hero {
      padding-top: 2.5rem;
    }
  }
</style>
