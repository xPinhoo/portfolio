---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, profile } from '../data/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${profile.name}`}>
  <section class="container section narrow">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk.</h1>
    <p class="muted lead">
      Always happy to talk about interesting projects and roles. The fastest way to reach me is by email or LinkedIn.
    </p>
    <div class="list">
      <a class="card row" href={`mailto:${profile.email}`}>
        <span class="muted">Email</span>
        <strong>{profile.email}</strong>
      </a>
      <a class="card row" href={links.linkedin} target="_blank" rel="noopener">
        <span class="muted">LinkedIn</span>
        <strong>francisco-pinho</strong>
      </a>
      {
        links.github && (
          <a class="card row" href={links.github} target="_blank" rel="noopener">
            <span class="muted">GitHub</span>
            <strong>{links.github.replace('https://github.com/', '')}</strong>
          </a>
        )
      }
      <div class="card row">
        <span class="muted">Based in</span>
        <strong>{profile.location}</strong>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 640px;
  }
  .lead {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--text);
    text-decoration: none;
    padding: 1rem 1.25rem;
  }
  a.row:hover {
    border-color: var(--accent);
  }
  strong {
    overflow-wrap: anywhere;
  }
</style>
