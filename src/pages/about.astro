---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatRow from '../components/about/StatRow.astro';
import WaveScene from '../components/about/WaveScene.astro';
import FlightScene from '../components/about/FlightScene.astro';
import CoinConsole from '../components/about/CoinConsole.vue';
import { languages, profile, yearsOfExperience } from '../data/site';

const chapters = [
  { id: 'water', num: '01', title: 'Born by the water' },
  { id: 'sky', num: '02', title: 'Aiming for the sky' },
  { id: 'code', num: '03', title: '"How does this work?"' },
  { id: 'today', num: '04', title: 'Today' },
];

const icons: Record<string, string> = {
  water:
    'M2 7c.6.5 1.2 1 2.5 1C7 8 7 6 9.5 6c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 13c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 19c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1',
  sky: 'M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z',
  code: 'M4 17l6-6-6-6M12 19h8',
  today: 'M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z',
};

const facts = [
  { label: 'From', value: 'Figueira da Foz, Portugal' },
  { label: 'Before code', value: 'National team rower · Air Force' },
  { label: 'Nickname', value: '"Batoteiro"' },
  { label: 'Off the clock', value: 'Formula 1, FPS games on PC, the water' },
  { label: 'Speaks', value: languages.map((l) => l.name).join(', ') },
];
---

<BaseLayout title="About" description={`The story of ${profile.name}: from rowing and the Air Force to front-end development.`}>

  <div class="read-progress" aria-hidden="true"><span></span></div>

  <section class="container section">
    <header class="intro">
      <div>
        <p class="eyebrow rise">About me</p>
        <h1>
          <span class="rise" style="--d: 0.1s">Rower,</span>{' '}
          <span class="rise" style="--d: 0.25s">almost-pilot,</span>{' '}
          <span class="rise accent" style="--d: 0.4s">developer.</span>
        </h1>
        <p class="lead muted rise" style="--d: 0.55s">
          My path into software wasn't a straight line, but looking back, the curiosity was there all along.
        </p>
        <a class="scroll-hint rise" style="--d: 0.7s" href="#water">Scroll the story ↓</a>
      </div>
      <div class="photo-wrap rise" style="--d: 0.2s">
        <Image class="photo" src={profilePhoto} alt={`Portrait of ${profile.name}`} width={360} loading="eager" />
      </div>
    </header>

    <div class="layout">
      <div class="story">
        <div class="rail" aria-hidden="true"><span class="rail-fill"></span></div>

        <section class="chapter" id="water" data-chapter>
          <span class="marker" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.water}></path></svg></span>
          <h2><span class="num">01</span> Born by the water</h2>
          <div class="prose reveal">
            <p>
              I was born in 1996 in <strong>Figueira da Foz</strong>, a coastal town known for its beaches, so it's no
              surprise I was drawn to the water from a young age. I started rowing at <strong>Naval 1º de Maio</strong>,
              the local club, and took it seriously. At 1.86 m, my height helped, and with the results that followed I
              was invited to join the <strong>Portuguese national team</strong>.
            </p>
            <p>
              Representing Portugal, I competed in two consecutive European Championships, finishing <strong>5th</strong> and then <strong>4th</strong>.
              Rowing taught me discipline, consistency and what it means to be part of a crew where everyone has to pull
              in the same rhythm.
            </p>
          </div>
          <StatRow
            stats={[
              { value: 1.86, decimals: 2, suffix: ' m', label: 'tall, an advantage in the boat' },
              { value: 2, label: 'European Championships for Portugal' },
              { value: 4, suffix: 'th', label: 'best finish in Europe' },
            ]}
          />
          <WaveScene />
        </section>

        <section class="chapter" id="sky" data-chapter>
          <span class="marker" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.sky}></path></svg></span>
          <h2><span class="num">02</span> Aiming for the sky</h2>
          <div class="prose reveal">
            <p>
              My father served as a military paratrooper, and growing up around his stories gave me a real interest in
              aviation and military life. After high school I enlisted in the <strong>Portuguese Air Force</strong> with
              one goal: to become a pilot. I was accepted and on track.
            </p>
            <p>
              Then an injury revealed that my back would not allow me to pursue a career as a pilot. It was a hard
              moment, but it pushed me to look at something I had always treated as just a hobby.
            </p>
          </div>
          <FlightScene />
        </section>

        <section class="chapter" id="code" data-chapter>
          <span class="marker" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.code}></path></svg></span>
          <h2><span class="num">03</span> "How does this work?"</h2>
          <div class="prose reveal">
            <p>
              For as long as I can remember, I was fascinated watching older family members use the computer: printing
              documents, searching the web, playing Pinball and Minesweeper. I always wanted to know how it worked and
              what else it could do. Once I convinced my parents to buy me one, there was no going back.
            </p>
            <p>
              Then <strong>Minecraft</strong> came along. Playing with friends wasn't enough; I wanted to know how to run
              my own server and let people outside my circle join. That's where I first touched anything resembling
              code: editing config files, setting up and hosting online servers, figuring things out one problem at a
              time. That started a rollercoaster of ideas, and the interest never left.
            </p>
          </div>

          <aside class="callout reveal">
            <p class="eyebrow">A confession</p>
            <p>
              During my Computer Science degree, my flatmates and I got hooked on <em>EverWing</em>, an arcade shooter
              you could play inside Facebook Messenger, flying through waves of monsters and collecting coins. Naturally,
              I wanted the most coins. So I opened the browser dev tools, dug through the game's JavaScript files and
              found which functions I could call from the console to top up my balance.
            </p>
            <p>
              It was harmless and spoiled nothing for anyone, but to this day my friends call me <strong>"Batoteiro"</strong>, Portuguese for <em>cheater</em>.
              The irony: as a lifelong PC gamer and FPS fan, real cheaters are the thing I can't stand. For me it was
              never about winning; it was about understanding how it worked.
            </p>
          </aside>

          <div class="reveal">
            <p class="try">Go on, see how it felt. <span class="muted">(It's a toy, nothing real happens.)</span></p>
            <CoinConsole client:idle />
          </div>
        </section>

        <section class="chapter" id="today" data-chapter>
          <span class="marker" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.today}></path></svg></span>
          <h2><span class="num">04</span> Today</h2>
          <div class="prose reveal">
            <p>
              I graduated in Computer Science from the University of Aveiro and have spent more than {yearsOfExperience} years
              building front-end applications, from a CRM platform at Altice Labs, to Vodafone's eShop, to fleet
              management products at Frotcom. The same curiosity that made me open the dev tools on a Messenger game now
              goes into building interfaces that are fast, maintainable and enjoyable to use.
            </p>
            <p>
              And the athlete in me is still there: I like working in a team that rows in the same direction, and I
              don't mind putting in the reps to get something right.
            </p>
            <p>
              Off the clock, race weekends are sacred: I love watching <strong>Formula 1</strong>. It's the perfect mix
              of the things I care about: a team where every role matters, engineering pushed to the limit, and
              strategy decided in milliseconds.
            </p>
          </div>
          <StatRow
            stats={[
              { value: yearsOfExperience, suffix: '+', label: 'years building front-ends' },
              { value: 3, label: 'companies, from telecom to fleets' },
              { value: 1, label: 'Adobe certification (AEM)' },
              { text: '∞', label: 'curiosity about how things work' },
            ]}
          />
          <div class="reveal end">
            <a class="btn primary" href="/experience">See my experience →</a>
            <a class="btn" href="/projects">What I build for fun</a>
          </div>
        </section>
      </div>

      <aside class="side">
        <nav class="card chapters" aria-label="Chapters">
          <h2>Chapters</h2>
          <ol>
            {
              chapters.map((c) => (
                <li>
                  <a href={`#${c.id}`} data-nav={c.id}>
                    <span class="num">{c.num}</span>
                    {c.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="card">
          <h2>Quick facts</h2>
          <dl>
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { onScrollFrame, prefersReducedMotion, railProgress } from '../scripts/motion';

  const reduce = prefersReducedMotion();

  // --- Count-up numbers -------------------------------------------------------
  const fmt = (n: number, d: number) => n.toFixed(d);
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (!reduce) counters.forEach((el) => (el.textContent = fmt(0, Number(el.dataset.decimals))));

  function countUp(el: HTMLElement) {
    const to = Number(el.dataset.count);
    const d = Number(el.dataset.decimals);
    if (reduce) return void (el.textContent = fmt(to, d));
    const start = performance.now();
    const dur = 1400;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      el.textContent = fmt(to * (1 - Math.pow(1 - t, 3)), d);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // --- Flight path ------------------------------------------------------------
  function fly(fig: HTMLElement) {
    const anim = fig.querySelector('animateMotion') as SVGAnimationElement | null;
    if (!anim) return;
    if (reduce) anim.setAttribute('dur', '0.01s');
    fig.classList.remove('flying', 'landed');
    void fig.getBoundingClientRect(); // restart the CSS transition
    fig.classList.add('flying');
    anim.beginElement();
    setTimeout(() => fig.classList.add('landed'), reduce ? 0 : 3200);
  }
  document.querySelectorAll<HTMLElement>('[data-flight]').forEach((fig) => {
    fig.querySelector('[data-replay]')?.addEventListener('click', () => fly(fig));
  });

  // --- Start animations when their element is revealed (see initReveal) -------
  document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
    el.addEventListener(
      'reveal',
      () => {
        el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
        if (el.matches('[data-flight]')) setTimeout(() => fly(el), 300);
      },
      { once: true },
    );
  });

  // --- Scroll-linked: progress bar, story rail, active chapter ------------------
  const bar = document.querySelector<HTMLElement>('.read-progress span');
  const story = document.querySelector<HTMLElement>('.story');
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  onScrollFrame(() => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
    story?.style.setProperty('--rail', String(railProgress(story)));

    let active = -1;
    chapters.forEach((ch, i) => {
      if (ch.getBoundingClientRect().top < innerHeight * 0.5) active = i;
    });
    chapters.forEach((ch, i) => {
      ch.classList.toggle('is-active', i === active);
      ch.classList.toggle('is-past', i < active);
    });
    const activeId = chapters[active]?.id;
    navLinks.forEach((a) => (a.dataset.nav === activeId ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
  });
</script>

<style>
  /* Reading progress */
  .read-progress {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 20;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* Intro */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 3.5rem;
  }
  h1 span {
    display: inline-block;
  }
  .accent {
    color: var(--accent);
  }
  .lead {
    font-size: 1.2rem;
    max-width: 560px;
    margin: 0;
  }
  .scroll-hint {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    text-decoration: none;
    animation-name: rise, nudge;
    animation-duration: 0.7s, 2s;
    animation-delay: var(--d), 1.6s;
    animation-iteration-count: 1, infinite;
    animation-fill-mode: both, none;
  }
  .rise {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .photo-wrap {
    position: relative;
    padding: 14px;
  }
  .photo-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px dashed var(--accent);
    opacity: 0.5;
    animation: spin 30s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 35%;
    border: 4px solid var(--surface);
    box-shadow:
      0 0 0 1px var(--border),
      0 12px 32px -12px rgb(0 0 0 / 0.35);
  }

  /* Layout */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 3rem;
    align-items: start;
  }

  /* Story rail + chapter markers */
  .story {
    position: relative;
    padding-left: 64px;
    max-width: 720px;
    min-width: 0;
  }
  .rail {
    position: absolute;
    left: 19px;
    top: 20px;
    bottom: 0;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .rail-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--rail, 0));
  }
  .chapter {
    position: relative;
    padding-bottom: 3.5rem;
    scroll-margin-top: 90px;
  }
  .chapter:last-child {
    padding-bottom: 0;
  }
  .marker {
    position: absolute;
    left: -64px;
    top: -6px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border);
    color: var(--muted);
    transition:
      background 0.3s,
      border-color 0.3s,
      color 0.3s,
      transform 0.3s;
  }
  .marker svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chapter.is-past .marker {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chapter.is-active .marker {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.12);
  }
  .chapter h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .num {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
  }

  .callout {
    margin: 1.75rem 0;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    border-left: 4px solid var(--accent);
  }
  .callout p:last-child {
    margin-bottom: 0;
  }
  .try {
    margin: 0;
    font-weight: 500;
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  /* Sidebar */
  .side {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .side h2 {
    font-size: 1.05rem;
  }
  .chapters ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .chapters a {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.35rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .chapters a:hover {
    color: var(--text);
  }
  .chapters a[aria-current] {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }
  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 500;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .chapters {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .photo-wrap {
      order: -1;
      justify-self: start;
      padding: 10px;
    }
    .photo {
      width: 110px;
      height: 110px;
    }
    .story {
      padding-left: 46px;
    }
    .rail {
      left: 14px;
    }
    .marker {
      left: -46px;
      width: 30px;
      height: 30px;
      top: -2px;
    }
    .marker svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
