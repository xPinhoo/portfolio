---
import '../styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
import { basePath, href, htmlLang, langOf, langs, ogLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = langOf(Astro.url);
const { title, description = profile.headline[lang] } = Astro.props;
const fullTitle = title ? `${title} · ${profile.shortName}` : `${profile.shortName} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The same page in every language, for search engines.
const page = basePath(Astro.url.pathname);
const alternates = langs.map((l) => ({ lang: htmlLang[l], url: new URL(href(l, page), Astro.site).href }));
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#121316" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Apply saved theme before paint to avoid a flash; opt in to scroll-reveal animations.
         Runs again after each client-side navigation, since the new page's <html> replaces these attributes. -->
    <script is:inline>
      function prepareRoot(doc) {
        if ('IntersectionObserver' in window) doc.documentElement.classList.add('js-anim');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') doc.documentElement.dataset.theme = t;
        } catch {}
      }
      prepareRoot(document);
      document.addEventListener('astro:before-swap', (e) => prepareRoot(e.newDocument));
    </script>
    <!-- Navigate without full reloads; pages cross-fade instead -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal, onPage } from '../scripts/motion';

      // Switching language keeps your place on the page and shows content that was already revealed.
      let keepScroll: number | null = null;
      document.addEventListener('click', (e) => {
        if ((e.target as Element).closest('[data-lang-switch]')) keepScroll = scrollY;
      });
      document.addEventListener('astro:after-swap', () => {
        if (keepScroll === null) return;
        scrollTo({ top: keepScroll, behavior: 'instant' });
        keepScroll = null;
        document.querySelectorAll('.reveal').forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) el.classList.add('is-visible');
        });
      });

      onPage(initReveal);
    </script>
  </body>
</html>
