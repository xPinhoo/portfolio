---
// Animated illustration used as a cover for projects without a screenshot.
interface Props {
  visual: 'voice' | 'crosshair' | 'calendar';
}

const { visual } = Astro.props;
const bars = [0.35, 0.7, 1, 0.6, 0.85, 0.45, 0.75];
---

<div class:list={['visual', visual]} aria-hidden="true">
  {
    visual === 'voice' && (
      <svg viewBox="0 0 160 90">
        <circle class="ring" cx="80" cy="45" r="30" />
        <circle class="ring outer" cx="80" cy="45" r="38" />
        {bars.map((h, i) => (
          <rect class="bar" x={62 + i * 5.5} y={45 - 14 * h} width="3" height={28 * h} rx="1.5" style={`--i: ${i}`} />
        ))}
      </svg>
    )
  }
  {
    visual === 'crosshair' && (
      <svg viewBox="0 0 160 90">
        <g class="scope">
          <circle cx="80" cy="45" r="24" />
          <path d="M80 13 V33 M80 57 V77 M48 45 H68 M92 45 H112" />
        </g>
        <circle class="dot" cx="80" cy="45" r="2.5" />
        <circle class="hit" cx="80" cy="45" r="6" />
      </svg>
    )
  }
  {
    visual === 'calendar' && (
      <svg viewBox="0 0 160 90">
        <rect class="page" x="50" y="14" width="60" height="62" rx="6" />
        <path class="top" d="M50 30 H110" />
        <path class="pins" d="M64 9 V19 M96 9 V19" />
        {Array.from({ length: 12 }, (_, i) => (
          <rect class="day" x={57 + (i % 4) * 12.5} y={36 + Math.floor(i / 4) * 12.5} width="8" height="8" rx="2" />
        ))}
        <rect class="day booked" x={82} y={48.5} width="8" height="8" rx="2" />
        <path class="check" d="M83.5 52.5 l2 2 l3.5 -4" />
      </svg>
    )
  }
</div>

<style>
  .visual {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%),
      linear-gradient(135deg, var(--accent-soft), var(--surface));
  }
  svg {
    width: 70%;
    max-width: 340px;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Voice: equalizer bars inside a glowing ring */
  .ring {
    opacity: 0.5;
  }
  .ring.outer {
    opacity: 0.2;
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 3s ease-in-out infinite;
  }
  .bar {
    fill: var(--accent);
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: talk 1.1s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.17s);
  }
  @keyframes talk {
    50% {
      transform: scaleY(0.35);
    }
  }
  @keyframes breathe {
    50% {
      transform: scale(1.08);
      opacity: 0.4;
    }
  }

  /* Crosshair: slow sweep, hit marker pulse */
  .scope {
    transform-box: fill-box;
    transform-origin: center;
    animation: sweep 6s ease-in-out infinite;
  }
  .dot {
    fill: var(--accent);
    stroke: none;
  }
  .hit {
    transform-box: fill-box;
    transform-origin: center;
    animation: hit 2s ease-out infinite;
  }
  @keyframes sweep {
    0%,
    100% {
      transform: translate(0, 0) rotate(0);
    }
    30% {
      transform: translate(-6px, 3px) rotate(-8deg);
    }
    60% {
      transform: translate(5px, -2px) rotate(6deg);
    }
  }
  @keyframes hit {
    from {
      transform: scale(0.4);
      opacity: 0.9;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* Calendar: a slot gets booked */
  .page {
    fill: var(--surface);
  }
  .top,
  .pins {
    opacity: 0.8;
  }
  .day {
    fill: color-mix(in srgb, var(--accent) 18%, transparent);
    stroke: none;
  }
  .day.booked {
    fill: var(--accent);
    animation: book 3s ease-in-out infinite;
  }
  .check {
    stroke: var(--surface);
    stroke-width: 1.6;
    stroke-dasharray: 10;
    stroke-dashoffset: 10;
    animation: tick 3s ease-in-out infinite;
  }
  @keyframes book {
    0%,
    15% {
      fill: color-mix(in srgb, var(--accent) 18%, transparent);
    }
    30%,
    85% {
      fill: var(--accent);
    }
    100% {
      fill: color-mix(in srgb, var(--accent) 18%, transparent);
    }
  }
  @keyframes tick {
    0%,
    30% {
      stroke-dashoffset: 10;
    }
    45%,
    85% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 10;
    }
  }
</style>
