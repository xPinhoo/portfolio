---
import type { CollectionEntry } from 'astro:content';

type Recommendation = CollectionEntry<'experience'>['data']['recommendations'][number];

interface Props {
  rec: Recommendation;
}

const { rec } = Astro.props;
const initials = rec.author
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<figure class="rec">
  <span class="mark" aria-hidden="true">“</span>
  <blockquote>
    <p>{rec.quote}</p>
  </blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span class="who">
      <strong>{rec.author}</strong>
      <span class="muted">{rec.role} · {rec.relation} · {rec.date}</span>
    </span>
    {
      rec.url && (
        <a class="link" href={rec.url} target="_blank" rel="noopener">
          View on LinkedIn ↗
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  .rec {
    position: relative;
    margin: 0 0 1rem;
    padding: 1.1rem 1.2rem 1rem 1.2rem;
    border-radius: 10px;
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    overflow: hidden;
  }
  .mark {
    position: absolute;
    top: -0.9rem;
    right: 0.6rem;
    font-family: Georgia, serif;
    font-size: 6rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.18;
    pointer-events: none;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    font-style: italic;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.85rem;
  }
  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--bg);
    background: var(--accent);
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
    min-width: 180px;
  }
  .who strong {
    font-size: 0.92rem;
  }
  .who .muted {
    font-size: 0.78rem;
  }
  .link {
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
  }
  .link:hover {
    text-decoration: underline;
  }
</style>
