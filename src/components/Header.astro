---
import ThemeToggle from './ThemeToggle.vue';
import { profile } from '../data/site';
import { href, langOf, switchPath, t } from '../i18n';

const lang = langOf(Astro.url);
const other = lang === 'en' ? 'pt' : 'en';
const { nav: labels, switchTo, theme } = t(lang);
const nav = (['about', 'experience', 'projects', 'contact'] as const).map((key) => ({
  href: href(lang, `/${key}`),
  label: labels[key],
}));

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header>
  <div class="container bar">
    <a href={href(lang, '/')} class="brand">{profile.shortName}</a>
    <nav aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <a class="lang" data-lang-switch href={switchPath(Astro.url.pathname, other)} hreflang={other} lang={other} title={switchTo}>
        <span class:list={{ on: lang === 'en' }}>EN</span><span class:list={{ on: lang === 'pt' }}>PT</span>
        <span class="sr">{switchTo}</span>
      </a>
      <ThemeToggle client:load labels={theme} />
    </div>
  </div>
</header>

<style lang="scss">
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
    a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.95rem;
      padding: 0.25rem 0;
      &:hover,
      &[aria-current='page'] {
        color: var(--text);
      }
      &[aria-current='page'] {
        box-shadow: inset 0 -2px 0 var(--accent);
      }
    }
  }
  nav {
    margin-left: auto;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang {
    display: inline-flex;
    color: var(--muted);
    text-decoration: none;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    span {
      padding: 0.2rem 0.45rem;
      border-radius: 999px;
      transition:
        background 0.2s,
        color 0.2s;
    }
    .on {
      background: var(--accent);
      color: var(--bg);
    }
    &:hover {
      border-color: var(--accent);
    }
    .sr {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (max-width: 560px) {
    .bar {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
    .tools {
      order: 1;
    }
    nav {
      order: 2;
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
    }
  }
</style>
