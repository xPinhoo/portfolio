---
import type { Job } from '../lib/content';
import { langOf, t } from '../i18n';

type Team = Job['data']['teams'][number];
type Role = Team['members'][number]['role'];

interface Props {
  teams: Team[];
}

const { teams } = Astro.props;
const ui = t(langOf(Astro.url)).team;

const keys: Record<Role, string> = { frontend: 'fe', backend: 'be', qa: 'qa', po: 'pm', sm: 'pm', 'po-sm': 'pm' };
const roles = Object.fromEntries(
  Object.entries(keys).map(([role, key]) => {
    const [one, many] = ui.roles[role as Role];
    return [role, { one, many, key }];
  }),
) as Record<Role, { one: string; many: string; key: string }>;
const lang = langOf(Astro.url);
const note = (n?: string) => (n ? (ui.notes[n] ?? n) : undefined);
// "junior front-end dev" in English, "dev front-end júnior" in Portuguese.
const describe = (role: string, n?: string) => (!n ? role : lang === 'pt' ? `${role} ${note(n)}` : `${note(n)} ${role}`);

const summarize = (team: Team) => {
  const size = team.members.reduce((n, m) => n + m.count, 0);
  const parts = team.members.map((m) => {
    const r = roles[m.role];
    if (m.me) return `${ui.me} (${ui.meRole[m.role]}${m.note ? `, ${note(m.note)}` : ''})`;
    return `${m.count} ${describe(m.count === 1 ? r.one : r.many, m.note)}`;
  });
  return { size, text: parts.join(', ') };
};

// One dot per person, "me" first.
const dots = (team: Team) =>
  [...team.members]
    .sort((a, b) => Number(b.me) - Number(a.me))
    .flatMap((m) =>
      Array.from({ length: m.count }, () => ({
        key: roles[m.role].key,
        me: m.me,
        label: m.me ? ui.meDot : describe(roles[m.role].one, m.note),
      })),
    );

const legend = Object.entries(ui.legend).map(([key, label]) => ({ key, label }));
---

{
  teams.length > 0 && (
    <div class="teams">
      <p class="title">{teams.length > 1 ? ui.teams(teams.length) : ui.team}</p>
      {teams.map((team) => {
        const s = summarize(team);
        return (
          <div class:list={['team', { lead: team.lead }]}>
            <div class="head">
              {team.name && <span class="name">{team.name}</span>}
              {team.lead && <span class="lead-badge">{ui.ledByMe}</span>}
              <span class="size">{ui.people(s.size)}</span>
            </div>
            <div class="dots" aria-hidden="true">
              {dots(team).map((d) => (
                <span class:list={['dot', d.key, { me: d.me }]} title={d.label} />
              ))}
            </div>
            <p class="desc">{s.text}</p>
            {team.note && <p class="desc note">{team.note}</p>}
          </div>
        );
      })}
      <ul class="legend" aria-hidden="true">
        {legend.map((l) => (
          <li>
            <span class:list={['dot', 'small', l.key]} />
            {l.label}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .teams {
    --fe: var(--accent);
    --be: #5b8def;
    --qa: #d9a23b;
    --pm: #9b8cf5;
    margin: 0.25rem 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .team + .team {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-bottom: 0.45rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .size {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .lead-badge {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bg);
    background: var(--accent);
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
  }
  .dots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 0.4rem;
  }
  .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--c);
    flex-shrink: 0;
  }
  .dot.fe {
    --c: var(--fe);
  }
  .dot.be {
    --c: var(--be);
  }
  .dot.qa {
    --c: var(--qa);
  }
  .dot.pm {
    --c: var(--pm);
  }
  .dot.me {
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 4px var(--c);
    margin: 0 4px;
  }
  .dot.small {
    width: 9px;
    height: 9px;
  }
  .desc {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }
  .note {
    margin-top: 0.2rem;
    font-style: italic;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0.75rem 0 0;
    padding: 0.6rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
